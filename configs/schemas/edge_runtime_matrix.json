      "candidate_row_ids",
      "observation_alignment_status",
      "observation_alignment_gaps",
      "selected_row_id",
      "runtime",
      "backend",
      "model_format",
      "thread_count",
      "thread_count_status",
      "mmap_strategy",
      "criterion",
      "claim_boundary"
    ],
    "selection_boundary": "A runtime can only become a target execute performance candidate after comparable configuration identity, successful lifecycle, aligned observed prompt/generated token counts and finish reason, observed memory fit, configured-workload TPOT and configured-workload generated-token throughput are present for every row. Multi-session rows use the synchronized concurrent window; single-session rows use serial measurement. Plan mode cannot select a runtime."
  },
  "comparison_identity_quality_observation_contract": {
    "required_fields": [
      "status",
      "reference_row_id",
      "observations",
      "matching_row_ids",
      "mismatching_row_ids",
      "unavailable_row_ids",
      "criterion",
      "fingerprint_algorithm",
      "capture_limit_bytes",
      "matrix_capture_limit_bytes",
      "claim_boundary"
    ],
    "observation_fields": [
      "row_id",
      "generated_text_bytes",
      "generated_text_fingerprint",
      "capture_status",
      "exact_match_with_reference",
      "first_mismatch_byte_offset",
      "generated_text_emitted"
    ],
    "comparison_boundary": "Only rows with aligned logical identity, complete execute observations and nonempty generated callback text may compare the exact bounded bytes retained in memory for one deterministic request. Any capture or empty-output gap makes every row unavailable for that comparison. Capture is bounded to 1 MiB per row, 8 MiB per matrix and 64 rows; exceeding a text budget makes the comparison unavailable without changing performance evidence. Generated text is not emitted. FNV-1a is a non-cryptographic diagnostic fingerprint and is not the equality authority. A mismatch offset identifies the first differing byte position without exposing text. A match is not a model-quality, logit, token-id or quantization-equivalence claim; a mismatch is not a performance blocker."
  },
  "claim_boundary": "Plan and capability rows remain non-execute evidence and cannot select a runtime. A performance candidate requires every comparable row to complete the serial cold/warm/cancel protocol and provide observed memory fit, median measurement TPOT and median measurement decode throughput. Warmup and cancel-probe timing are excluded from those medians. The candidate is not concurrent-session, quality, power, thermal, production or release evidence. Null metrics must never be interpreted as zero measurements."
}
